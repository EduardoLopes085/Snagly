# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# WXT, Vite and TypeScript generated files
/.output/
/.wxt/
/dist/
/build/
.vite/
.cache/
*.tsbuildinfo
vite.config.*.timestamp-*

# Test output, browser profiles and downloaded test files
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/browser-check-*/

# Logs and runtime diagnostics
logs/
*.log
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local environment values; keep templates versionable
.env
.env.*
!.env.example
!.env.*.example

# Local editor and operating-system files
.idea/
.vscode/*.local.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Temporary working files
/tmp/
/temp/
*.tmp
*.temp
